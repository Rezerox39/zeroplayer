# ZeroPlayer - Environment Configuration
# Copy to .env and fill in your credentials

# ── Jellyfin Server ──────────────────────────────────────────
# JELLYFIN_SERVER_URL=http://192.168.1.100:8096
# JELLYFIN_API_KEY=your_api_key_here
# JELLYFIN_USER_ID=your_user_uuid_here

# ── YouTube Music ────────────────────────────────────────────
# Uses yt-dlp for stream resolution (no API key needed).
# Install: pip install yt-dlp
# Search and streaming work without authentication.

# ── Telegram (user login via Pyrogram) ──────────────────────
# Uses Pyrogram for user login (phone → code → 2FA).
# Get API credentials from https://my.telegram.org
# Install: pip install pyrogram
# Configure via the in-app Settings panel (API ID + Hash).

# ── Lyrics ───────────────────────────────────────────────────
# LYRICS_PROVIDER=ytmusic  (ytmusic | genius | musixmatch)
# Uses Genius HTML scraping + lyrics.ovh REST API (free, no key needed)
