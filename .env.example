# ZeroPlayer - Environment Configuration
# Copy to .env and fill in your credentials

# ── Jellyfin Server ──────────────────────────────────────────
# JELLYFIN_SERVER_URL=http://192.168.1.100:8096
# JELLYFIN_API_KEY=your_api_key_here
# JELLYFIN_USER_ID=your_user_uuid_here

# ── YouTube Music ────────────────────────────────────────────
# Requires ytmusicapi setup:
#   python3 python/ytmusic_bridge.py setup ~/.config/zeroplayer/oauth.json
# Or place browser cookies as oauth.json in the config directory.
# YTMUSIC_AUTH_FILE=~/.config/zeroplayer/oauth.json
# YTMUSIC_LANGUAGE=en
# YTMUSIC_REGION=US

# ── Telegram Bot ─────────────────────────────────────────────
# Create a bot via @BotFather on Telegram
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# TELEGRAM_CHANNELS=@your_music_channel, @another_channel

# ── Lyrics ───────────────────────────────────────────────────
# LYRICS_PROVIDER=ytmusic  (ytmusic | genius | musixmatch)
# GENIUS_ACCESS_TOKEN=your_genius_token_here
